{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "denim-products",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "vars": {
    "VITE_API_BASE_URL": "https://denim-products.onrender.com/api/v1"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
